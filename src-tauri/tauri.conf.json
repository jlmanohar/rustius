{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rustius",
  "version": "0.1.1",
  "identifier": "app.rustius.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rustius",
        "width": 1180,
        "height": 680,
        "minWidth": 840,
        "minHeight": 500,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../resources/binaries/freerdp/wfreerdp.exe"
    ]
  }
}
